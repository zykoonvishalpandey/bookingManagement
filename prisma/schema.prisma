// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}




// Enum for user roles to ensure type safety
enum Role {
  ADMIN
  USER
  MANAGER
}

// Enum for booking status
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum status {
  ACTIVE
  INACTIVE
  DELETED
}
// Enum for payment status
enum PaymentStatus {
  PENDING
  COMPLETED
  HOLD
}

// Enum for payment modes
enum PaymentMode {
  UPI
  NEFT
  RTGS
  IMPS
  CARD
  WALLET
  CHEQUE
  CASH
}

enum PaymentType {
  CREDIT
  DEBIT
}



enum PaymentDescType {
  BOOKING
  SALARY
  REFUND
  OTHER
  MISCEXPENSE
  COMMISSION
  ADVERTISEMENT
  DONATION
  MEMBERSHIP
  SPONSORSHIP
  RENTAL
  UTILITIES
  MAINTENANCE
  TAX
  INSURANCE
  LEGAL
  TRAINING
  MARKETING
  TRAVEL
  OFFICE_SUPPLIES
  EQUIPMENT
  CONSULTING
  RESEARCH
  DEVELOPMENT
  SUBSCRIPTION
  SOFTWARE
  HARDWARE
  LICENSE
  SERVICE
  CONTRACT
  PARTNERSHIP
  AFFILIATE
  SPONSORSHIP_INCOME
  GRANT
  INVESTMENT
  LOAN
}

// Enum for game types
enum GameType {
  TURF_CRICKET
  PICKLE_BALL_COURT_1
  PICKLE_BALL_COURT_2
  CRICKET_GROUND
  BADMINTON_OUTDOOR
  KIDS_PLAY_AREA
}

enum ActivityType {
  LOGIN
  LOGOUT
  BOOKING
  PAYMENT
}

// User model for managing user information
model User {
  id              Int         @id @default(autoincrement())
  email           String      @unique @db.VarChar(255)
  full_name       String?     @db.VarChar(100)
  image_url       String?     @db.VarChar(500)
  phone_number    String?     @db.VarChar(20)
  address         String?     @db.Text
  password        String      @db.VarChar(255) @default("default123")
  role            Role        @default(USER)
  last_login      DateTime?   @db.Timestamptz
  created_at      DateTime    @default(now()) @db.Timestamptz
  updated_at      DateTime    @updatedAt @db.Timestamptz
  created_by      Int         @default(1) // References User.id of creator
  updated_by      Int         @default(1) // References User.id of updater
  is_active       Boolean     @default(true)
  is_deleted      Boolean     @default(false)
  bookings        Booking[]   @relation("UserBookings")
  payments        Payment[]   @relation("UserPaymentsCreated")
  payments_updated Payment[]  @relation("UserPaymentsUpdated")
  @@index([email])
  @@index([role])
  @@map("users")
}

model ActivityLog {
  id              Int         @id @default(autoincrement())
  user_id         Int
  activity_type   ActivityType
  activity_details String
  created_at      DateTime    @default(now()) @db.Timestamptz
} 

// Game model for managing game details
model Game {
  id              Int         @id @default(autoincrement())
  name            GameType    @unique
  description     String?     @db.Text
  image_url       String?     @db.VarChar(500)
  slot_duration   Int         @default(60) // Duration in minutes
  created_at      DateTime    @default(now()) @db.Timestamptz
  updated_at      DateTime    @updatedAt @db.Timestamptz
  created_by      Int         @default(1) // References User.id of creator
  updated_by      Int         @default(1) // References User.id of updater
  is_active       Boolean     @default(true)
  is_deleted      Boolean     @default(false)
  slots           Slot[]      @relation("GameSlots")
  @@index([name])
  @@map("games")
}

// Slot model for managing game time slots
model Slot {
  id              Int         @id @default(autoincrement())
  game_id         Int
  start_time      DateTime    @db.Timestamptz
  end_time        DateTime    @db.Timestamptz
  price           Decimal     @default(0.00) @db.Decimal(10, 2)
  name            String?     @db.VarChar(100)
  description     String?     @db.Text
  status           status       @default(ACTIVE)
  created_at      DateTime    @default(now()) @db.Timestamptz
  updated_at      DateTime    @updatedAt @db.Timestamptz
  created_by      Int         @default(1) // References User.id of creator
  updated_by      Int         @default(1) // References User.id of updater
  is_active       Boolean     @default(true)
  is_deleted      Boolean     @default(false)
  game            Game        @relation("GameSlots", fields: [game_id], references: [id], onDelete: Cascade)
  bookings        Booking[]   @relation("SlotBookings")
  @@unique([game_id, start_time, end_time])
  @@index([game_id])
  @@index([start_time])
  @@map("slots")
}

// Booking model for managing user bookings
model Booking {
  id              Int           @id @default(autoincrement())
  user_id         Int
  slot_id         Int
  status          BookingStatus @default(PENDING)
  booking_date    DateTime      @db.Timestamptz
  amount          Decimal       @db.Decimal(10, 2)
  created_at      DateTime      @default(now()) @db.Timestamptz
  updated_at      DateTime      @updatedAt @db.Timestamptz
  created_by      Int           @default(1) // References User.id of creator
  updated_by      Int           @default(1) // References User.id of updater
  is_active       Boolean       @default(true)
  is_deleted      Boolean       @default(false)
  user            User          @relation("UserBookings", fields: [user_id], references: [id], onDelete: Restrict)
  slot            Slot          @relation("SlotBookings", fields: [slot_id], references: [id], onDelete: Restrict)
  payments        Payment[]     @relation("BookingPayments")
  @@index([user_id])
  @@index([slot_id])
  @@index([status])
  @@index([user_id, booking_date])
  @@map("bookings")
}

// Payment model for managing payment transactions
model Payment {
  id                 Int           @id @default(autoincrement())
  booking_id         Int?          // Changed to optional
  amount             Decimal       @db.Decimal(10, 2)
  reference_no       String        @unique @db.VarChar(100) // Unique transaction reference (e.g., from payment gateway)
  description        String?       @db.Text
  payment_type       PaymentType
  payment_status     PaymentStatus
  payment_mode       PaymentMode
  payment_desc_type  PaymentDescType
  created_at         DateTime      @default(now()) @db.Timestamptz
  updated_at         DateTime      @updatedAt @db.Timestamptz
  created_by         Int           @default(1) // References User.id of creator
  updated_by         Int           @default(1) // References User.id of updater
  booking            Booking?      @relation("BookingPayments", fields: [booking_id], references: [id], onDelete: Cascade)
  user_created       User          @relation("UserPaymentsCreated", fields: [created_by], references: [id], onDelete: Restrict)
  user_updated       User          @relation("UserPaymentsUpdated", fields: [updated_by], references: [id], onDelete: Restrict)
  @@index([booking_id])
  @@index([payment_type])
  @@index([payment_status])
  @@index([reference_no])
  @@map("payments")
}